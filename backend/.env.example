# MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="vigil_db"

# Google OAuth (REQUIRED - for authentication)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add http://localhost:8001/api/auth/google/callback as Authorized redirect URI
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS="*"

# Firecrawl - for scraping protected sites (optional)
FIRECRAWL_MODE=cloud
FIRECRAWL_API_KEY=your_firecrawl_api_key
# OR use self-hosted:
# FIRECRAWL_MODE=selfhosted
# FIRECRAWL_SELFHOSTED_URL=http://tu-servidor:3002/v2/scrape

# Optional: LLM API key for AI-powered extraction
# Replace with your preferred provider (OpenAI, Anthropic, etc.)
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Webhook for notifications (optional)
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com/notify

# Intervalo de verificación de precios (en horas)
PRICE_CHECK_INTERVAL_HOURS=12