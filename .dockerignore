# .dockerignore
# ==============================
# Exclude files from Docker build context
# Applied to all services in docker-compose.yml
# ==============================

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Node
**/node_modules/
**/.pnp
**/.pnp.js

# Environment files (keep .env.example, ignore actual .env)
**/.env
**/.env.local
**/.env.*.local

# Build outputs
**/build/
**/dist/
**/.next/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/

# OS files
.DS_Store
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files (already in the build context, but exclude from the image)
**/Dockerfile
**/docker-compose*.yml
**/nginx.conf
**/.dockerignore

# Test files
**/tests/
**/coverage/

# Documentation
**/*.md
**/DESIGN.md
**/CLAUDE.md
**/DEPLOY.md