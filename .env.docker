# .env.docker
# ==============================
# Environment variables for Docker deployment
# Copy to .env (which is gitignored) and fill in your secrets:
#   cp .env.docker .env
# Then run:
#   docker compose up -d
# ==============================

# MongoDB
MONGO_URL=mongodb://mongodb:27017
DB_NAME=vigil_db

# Google OAuth (REQUIRED - replace with your actual credentials)
# Create credentials at https://console.cloud.google.com/apis/credentials
# IMPORTANT: Add http://localhost/api/auth/google/callback as Authorized redirect URI
# for local Docker, or https://yourdomain.com/api/auth/google/callback for production
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For local Docker: http://localhost/api/auth/google/callback
# For production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# Frontend URL (for OAuth redirect after login)
# For local Docker: http://localhost
# For production:   https://yourdomain.com
FRONTEND_URL=http://localhost

# Port for the Vigil frontend (default: 3000)
# CloudPanel/nginx proxy apunta a este puerto.
# No usar 80 — CloudPanel ya usa ese puerto.
VIGIL_PORT=3000

# Firecrawl - for scraping protected sites (optional)
FIRECRAWL_MODE=cloud
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# FIRECRAWL_MODE=selfhosted
# FIRECRAWL_SELFHOSTED_URL=http://tu-servidor:3002/v2/scrape

# LLM API key for AI-powered extraction (optional)
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# Webhook for notifications (optional)
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com/notify

# Price check interval in hours
PRICE_CHECK_INTERVAL_HOURS=12